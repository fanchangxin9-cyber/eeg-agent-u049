# 复制为 .env 后按需修改。.env 已在 .gitignore 中，不会被提交。

# ---- Agnes 平台 ----
# 在 https://platform.agnes-ai.cn 创建
AGNES_API_KEY=your_agnes_api_key_here
AGNES_BASE_URL=https://api.agnes-ai.cn/v1

# 实际使用的模型（提交材料里要如实填写名称与版本）
AGNES_TEXT_MODEL=agnes-2.5-flash
AGNES_IMAGE_MODEL=agnes-image-2.5-flash

# ---- 产物缓存 ----
# 不设则默认落在 %LOCALAPPDATA%\eeg-agent\artifacts
# 刻意不放在仓库内：本仓库路径含中文，numpy 的 mmap 与部分 MNE 内部逻辑
# 在非 ASCII 路径下不够可靠，失败形态是难以定位的 Windows OSError。
# EEG_ARTIFACT_DIR=C:/Users/you/eeg-agent/artifacts

# ---- EEGMMIDB 数据 ----
# 必须预设。否则 mne.datasets.eegbci.load_data 会交互式询问数据目录，
# 而 stdio MCP server 没有 TTY，会直接挂住。
# 数据约 6–7 MB/被试（3 个 run），由 MNE 从 PhysioNet 自动下载。
MNE_DATASETS_EEGBCI_PATH=C:/Users/you/mne_data/EEGBCI
